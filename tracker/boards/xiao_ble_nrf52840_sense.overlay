/*
 * boards/xiao_ble_sense.overlay   (or xiao_ble.overlay — match your board name)
 */

&pinctrl {
    uart1_default: uart1_default {
        group1 {
            /* TX only — we don't need RX from ESP32-CAM */
            psels = <NRF_PSEL(UART_TX, 0, 6)>;  /* P0.06 — adjust to your wiring */
        };
    };

    uart1_sleep: uart1_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 6)>;
            low-power-enable;
        };
    };
};

&uart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart1_default>;
    pinctrl-1 = <&uart1_sleep>;
    pinctrl-names = "default", "sleep";
};